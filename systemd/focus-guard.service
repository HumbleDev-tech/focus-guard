[Unit]
Description=Focus-Guard Anti-Procrastination System Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/focus-guard
ExecStart=/usr/bin/python3 /opt/focus-guard/daemon/focus_daemon.py --config /etc/focus-guard/config.json
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=5

# Security hardening
ProtectSystem=strict
ReadWritePaths=/etc/hosts /run /etc/focus-guard
PrivateTmp=true

[Install]
WantedBy=multi-user.target
