[Unit]
Description=Focus-Guard Anti-Procrastination System Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/focus-guard-daemon --config /etc/focus-guard/config.json
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=5

# State & Runtime Directory Management
StateDirectory=focus-guard
ReadWritePaths=/etc/hosts /run /etc/focus-guard /var/lib/focus-guard

# Security hardening
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
