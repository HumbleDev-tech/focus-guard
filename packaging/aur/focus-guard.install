post_install() {
    echo ":: Focus-Guard installed successfully."
    echo ":: Enable and start the system daemon with:"
    echo "     sudo systemctl enable --now focus-guard.service"
    echo ":: The desktop tray applet can be started from your application launcher or:"
    echo "     focus-guard-tray &"
    echo ""
    echo ":: [IMPORTANT] DNS-over-HTTPS (DoH) Note:"
    echo ":: If using Firefox, Chrome, or Brave, ensure DNS-over-HTTPS is set to"
    echo ":: 'Off' or 'System DNS' so kernel /etc/hosts blocks work reliably."
}

post_upgrade() {
    echo ":: Focus-Guard upgraded successfully."
    echo ":: If focus-guard.service is running, restart it with:"
    echo "     sudo systemctl try-restart focus-guard.service"
}

pre_remove() {
    if [ -d /run/systemd/system ] && systemctl is-active --quiet focus-guard.service 2>/dev/null; then
        echo ":: Stopping Focus-Guard system daemon..."
        systemctl stop focus-guard.service 2>/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl disable focus-guard.service 2>/dev/null || true
    fi

    # Clean up /etc/hosts entries if left behind
    if [ -f /etc/hosts ] && grep -q "FOCUS-GUARD-BLOCK-START" /etc/hosts; then
        echo ":: Cleaning Focus-Guard markers from /etc/hosts..."
        sed -i '/### FOCUS-GUARD-BLOCK-START/,/### FOCUS-GUARD-BLOCK-END/d' /etc/hosts
    fi
}
